# =============================================================================
# seragl.io サーバーセットアップ 環境設定ファイル
# -----------------------------------------------------------------------------
# 使い方:
#   cp .env.sample .env
#   .env を編集して実際の値を入力する
#   .env は Git にコミットしないこと（.gitignore で除外済み）
# =============================================================================


# -----------------------------------------------------------------------------
# Tailscale
# -----------------------------------------------------------------------------
# 取得先: https://login.tailscale.com/admin/settings/keys
# 必要な権限: Reusable / Expiry: 90days 以上 / Ephemeral: No（サーバー用）
# Pre-authorized キーを使用することで tailscale up を自動化できる
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Cloudflare
# -----------------------------------------------------------------------------

# API Token
# 取得先: https://dash.cloudflare.com/profile/api-tokens
# 必要な権限:
#   - Zone / DNS / Edit          （DNS レコードの作成・更新に必要）
#   - Zone / Zone / Read         （Zone ID の参照に必要）
# スコープ: 対象 Zone（seragl.io）のみに限定することを推奨
CF_API_TOKEN=your-cloudflare-api-token-here

# Zone ID
# 取得先: Cloudflare ダッシュボード → seragl.io → 右サイドバー「Zone ID」
CF_ZONE_ID=your-cloudflare-zone-id-here


# -----------------------------------------------------------------------------
# Forgejo
# -----------------------------------------------------------------------------
# 初回セットアップ時に作成する管理者アカウントの情報
# Web UI の初回インストール画面で使用する（スクリプトによる自動作成は行わない）
FORGEJO_ADMIN_USER=admin
FORGEJO_ADMIN_EMAIL=admin@seragl.io
# 初回ログイン後に必ず変更すること
FORGEJO_ADMIN_PASSWORD=ChangeMe!Forgejo2026

# Forgejo が使用する内部シークレットキー（任意のランダム文字列 64 文字以上）
# 生成例: openssl rand -hex 32
FORGEJO_SECRET_KEY=changeme-replace-with-openssl-rand-hex-32-output


# -----------------------------------------------------------------------------
# Zabbix
# -----------------------------------------------------------------------------
# PostgreSQL のパスワード（Zabbix サーバーとDBが共有）
# 生成例: openssl rand -base64 24
ZABBIX_DB_PASSWORD=ChangeMe!ZabbixDB2026

# Zabbix Web UI の管理者初期パスワード
# デフォルト: Admin / zabbix → 初回ログイン後に必ず変更すること
ZABBIX_ADMIN_PASSWORD=ChangeMe!Zabbix2026


# -----------------------------------------------------------------------------
# Caddy / Cloudflare Origin Certificate
# -----------------------------------------------------------------------------
# Origin Certificate はスクリプトが自動取得できないため、手動で発行・配置すること。
# 発行手順:
#   1. Cloudflare ダッシュボード → seragl.io → SSL/TLS → Origin Server
#   2. Create Certificate（RSA 2048 / *.seragl.io / 15 years）
#   3. 証明書・秘密鍵を以下のパスに保存

# 証明書ファイルの配置先パス（Caddyfile から参照）
# ファイルは手動で /etc/caddy/certs/ に配置すること（パーミッション: 644）
CF_ORIGIN_CERT_PATH=/etc/caddy/certs/origin.pem

# 秘密鍵ファイルの配置先パス（パーミッション: 600、root のみ読み取り可）
CF_ORIGIN_KEY_PATH=/etc/caddy/certs/origin.key

# Cloudflare SSL/TLS モード確認
# ダッシュボード → seragl.io → SSL/TLS → Overview → "Full (Strict)" に設定すること
# Flexible や Full（非Strict）では中間者攻撃のリスクがあるため使用禁止

# Forgejo Actions Runner
# 取得先: https://git.seragl.io/-/admin/runners
FORGEJO_RUNNER_TOKEN=
